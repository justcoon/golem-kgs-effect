# =============================================================================
# Golem KGS - End-to-End (E2E) Test Environment Configuration Example
# =============================================================================

# Golem Release Version for containerized server
GOLEM_VERSION=1.5.10

# Host Port Mappings (ports exposed to host machine)
POSTGRES_HOST_PORT=5433
S3_HOST_PORT=9010
GOLEM_TEST_ROUTER_PORT=9881
GOLEM_TEST_CUSTOM_PORT=9006
GOLEM_TEST_MCP_PORT=9007
GOLEM_TEST_TOKEN=e2e-test-token

# Internal Docker Network Configuration (used by Golem container)
POSTGRES_HOST=postgres-e2e
POSTGRES_PORT=5432
POSTGRES_DB=golem_kg_e2e
POSTGRES_USER=golem_user
POSTGRES_PASSWORD=golem_password
DB_URL=postgresql://golem_user:golem_password@postgres-e2e:5432/golem_kg_e2e

# S3 / RustFS Internal Configuration
S3_ENDPOINT_URL=http://rustfs-e2e:9000
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin123
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=golem-documents

# Ollama Configuration (reached via host.docker.internal from Golem container)
OLLAMA_PORT=11434
EMBEDDING_API_BASE=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
LLM_API_BASE=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:1.5b
LLM_USE_FOR_ASK=false
