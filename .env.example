# =============================================================================
# Golem kg System Environment Configuration
# =============================================================================
# Copy this file to .env and modify values as needed
# This file works with: Docker Compose, Shell Scripts, and Rust Applications

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_DB=golem_kg
POSTGRES_USER=golem_user
POSTGRES_PASSWORD=golem_password
POSTGRES_PORT=5432
# Database URL for agents and applications
DB_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# S3 Configuration (RustFS / AWS)
# =============================================================================
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin123
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKETS=golem-documents,legal-docs,technical-docs,archive-docs
S3_PORT=9000
S3_ENDPOINT_URL=http://localhost:${S3_PORT}

# RustFS specific variables (inherited from AWS vars)
RUSTFS_ACCESS_KEY=${AWS_ACCESS_KEY_ID}
RUSTFS_SECRET_KEY=${AWS_SECRET_ACCESS_KEY}
RUSTFS_REGION=${AWS_DEFAULT_REGION}
RUSTFS_BUCKET=golem-documents
RUSTFS_PORT=${S3_PORT}
RUSTFS_ADDR=0.0.0.0:${S3_PORT}
RUSTFS_LOG_LEVEL=info

# =============================================================================
# Ollama Configuration
# =============================================================================
OLLAMA_PORT=11434
OLLAMA_HOST=0.0.0.0
OLLAMA_MODEL=nomic-embed-text
# Ollama variables for applications
EMBEDDING_MODEL=${OLLAMA_MODEL}
EMBEDDING_API_BASE=http://localhost:${OLLAMA_PORT}/v1
EMBEDDING_API_KEY=ollama

# =============================================================================
# Application Configuration
# =============================================================================
RUST_LOG=info
DATA_DIR=data

# =============================================================================
# Docker Configuration
# =============================================================================
# Note: Network name is static in docker-compose.yml (golem-kg-network)
